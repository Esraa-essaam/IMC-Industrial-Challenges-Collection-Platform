# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB - Auth & Facility Accounts)
MONGO_URI=mongodb://127.0.0.1:27017/imc_database
DB_URL=mongodb://127.0.0.1:27017/imc_database

# PostgreSQL Database Configuration (Phase 2 - Relational Form & Power BI)
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123
DB_NAME=imc_database
POSTGRES_URI=postgresql://postgres:123@localhost:5432/imc_database
DB_SSL=false

# Authentication & Security (JWT)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# CORS / Frontend Client URL
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Admin Seeder Configuration
ADMIN_EMAIL=admin@imc.gov.eg
ADMIN_PASSWORD=Admin123!
ADMIN_NAME="إدارة المنظومة الصناعية - IMC"
ADMIN_PHONE=01000000000
